---
import '../styles/global.css';
import { categories } from '../data/categories.js';
import { SITE } from '../data/site.js';
const {
  title = 'TechOrbit',
  description = SITE.description,
  image,
  ogType = 'website',
} = Astro.props;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const canonical = SITE.url + path;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="TechOrbit RSS" href="/rss.xml" />
    <meta name="theme-color" content="#F7F6F1" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    </script>
    <style>
      .nav-links { display: none; }
      .nav-links a { color: var(--text); text-decoration: none; font-weight: 600; padding: .5rem .75rem; border-radius: 999px; }
      .nav-links a:hover { background: var(--surface-2); }
      .nav-links a[aria-current="page"] { background: var(--indigo-soft); color: var(--indigo); }
      .right { display: flex; gap: .5rem; align-items: center; }
      .menu-btn { display: grid; }
      .mobile-menu { display: none; border-top: 1px solid var(--line); padding: .5rem 0 1rem; }
      .mobile-menu.open { display: block; }
      .mobile-menu a { display: block; padding: .75rem .25rem; color: var(--text); text-decoration: none; font-weight: 600; border-bottom: 1px solid var(--line); }
      .mobile-menu a[aria-current="page"] { color: var(--indigo); }
      a.icon-btn { text-decoration: none; }
      @media (min-width: 860px) {
        .nav-links { display: flex; gap: .25rem; }
        .menu-btn { display: none; }
        .mobile-menu, .mobile-menu.open { display: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label="TechOrbit home">Tech<span class="o">O<span class="orbit" aria-hidden="true"></span></span>rbit</a>
        <nav class="nav-links" aria-label="Main">
          {categories.map((c) => (
            <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>{c.name}</a>
          ))}
        </nav>
        <div class="right">
          <a class="icon-btn" href="/search/" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>
          </a>
          <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch to dark mode">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
            </svg>
          </button>
          <button id="menu-btn" class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="wrap">
        <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile">
          {categories.map((c) => (
            <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>{c.name}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap"><nav aria-label="Footer" style="display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin-bottom:.75rem"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/editorial-policy/">Editorial Policy</a><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/rss.xml">RSS</a></nav>© {year} TechOrbit. Independent technology coverage.</div>
    </footer>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      function sync() {
        const dark = root.getAttribute('data-theme') === 'dark';
        btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      }
      btn.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        sync();
      });
      sync();
      const mbtn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      mbtn.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        mbtn.setAttribute('aria-expanded', String(open));
        mbtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
    </script>
  </body>
</html>
